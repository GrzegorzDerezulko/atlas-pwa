name: Cancel stuck GitHub Pages deployment

on:
  workflow_dispatch:

permissions:
  contents: read
  pages: write

jobs:
  cancel:
    runs-on: ubuntu-latest

    steps:
      - name: Cancel stuck Pages deployment
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          curl -L \
            -X POST \
            -H "Accept: application/vnd.github+json" \
            -H "Authorization: Bearer ${GH_TOKEN}" \
            -H "X-GitHub-Api-Version: 2022-11-28" \
            "https://api.github.com/repos/${{ github.repository }}/pages/deployments/b6bf1daac6739f2b7ee619652747541f1ea7529e/cancel" \
            --fail-with-body
